prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
includedir=${prefix}/include/@GEOGRAMGFX_INCLUDE_SUBPATH@
libdir=${exec_prefix}/lib@LIB_SUFFIX@

Name: geogram_gfx
Description: Graphic rendering and GUI for geogram
Version: @VORPALINE_VERSION@
URL: https://github.com/BrunoLevy/geogram
Libs: -lgeogram_gfx -lgeogram -l@GEO_GLFW3_LIBNAME@
Cflags: -I${includedir}
